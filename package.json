{
  "name": "coursegrab",
  "productName": "CourseGrab",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahulgurujala/coursegrab.git"
  },
  "homepage": "https://github.com/rahulgurujala/coursegrab",
  "bugs": {
    "url": "https://github.com/rahulgurujala/coursegrab/issues"
  },
  "description": "A cross platform (Windows, Mac, Linux) desktop application for downloading your enrolled Udemy courses. Based on Udeler by Faisal Umair.",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder -wml",
    "build-win": "electron-builder -w",
    "build-mac": "electron-builder -m",
    "build-linux": "electron-builder -l",
    "dist": "build"
  },
  "build": {
    "appId": "com.rahulgurujala.coursegrab",
    "artifactName": "CourseGrab-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "assets/images/build"
    },
    "files": [
      "index.html",
      "index.js",
      "assets/**/*",
      "locale/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Utility",
      "target": "AppImage"
    }
  },
  "author": {
    "name": "rahulgurujala",
    "url": "https://github.com/rahulgurujala"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "jquery": "^3.5.0",
    "mt-files-downloader": "git+https://github.com/FaisalUmair/mt-files-downloader-wrapper.git",
    "node-vtt-to-srt": "git+https://github.com/riazXrazor/vtt-to-srt.git",
    "sanitize-filename": "^1.6.1"
  },
  "contributors": [
    {
      "name": "Faisal Umair",
      "email": "eff.umair@gmail.com",
      "url": "https://github.com/FaisalUmair"
    }
  ]
}
