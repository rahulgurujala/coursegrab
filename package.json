{
  "name": "coursegrab",
  "productName": "CourseGrab",
  "version": "2.2.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahulgurujala/coursegrab.git"
  },
  "homepage": "https://github.com/rahulgurujala/coursegrab",
  "bugs": {
    "url": "https://github.com/rahulgurujala/coursegrab/issues"
  },
  "description": "A cross platform (Windows, Mac, Linux) desktop application for downloading your enrolled Udemy courses. Based on Udeler.",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "node scripts/build.mjs",
    "build": "bun run build:renderer && electron-builder -wml",
    "build-win": "bun run build:renderer && electron-builder -w",
    "build-mac": "bun run build:renderer && electron-builder -m",
    "build-linux": "bun run build:renderer && electron-builder -l",
    "dist": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.rahulgurujala.coursegrab",
    "artifactName": "CourseGrab-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "assets/images/build"
    },
    "files": [
      "index.html",
      "dist/**/*",
      "assets/**/*",
      "!assets/js/ui.js",
      "!assets/js/engine.js",
      "!assets/js/details.js",
      "!assets/js/updater.js",
      "locale/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Utility",
      "target": "AppImage"
    }
  },
  "author": {
    "name": "rahulgurujala",
    "url": "https://github.com/rahulgurujala"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jquery": "4.0.1",
    "@types/node": "26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "electron-updater": "^6.8.9",
    "jquery": "^3.5.0",
    "node-vtt-to-srt": "git+https://github.com/riazXrazor/vtt-to-srt.git",
    "sanitize-filename": "^1.6.1"
  }
}
